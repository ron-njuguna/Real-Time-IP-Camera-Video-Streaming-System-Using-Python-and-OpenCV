# Copy this file to ".env" and edit it. ".env" is in .gitignore and is never committed.

# Set this to your private camera stream URL, or 0 to use the laptop webcam.
CAMERA_URL=

# Name drawn on the video
CAMERA_NAME=Camera 1

# Optional tuning (defaults shown)
# DISPLAY_WIDTH=960
# MAX_RECONNECTS=5
# RECONNECT_DELAY=1
# MAX_FAILED_READS=5
